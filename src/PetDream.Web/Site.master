<%@ Master Language="C#" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PetDream</title>
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <a class="skip-link" href="#noi-dung">Đến nội dung chính</a>
    <form id="form_chinh" runat="server">
        <asp:ScriptManager ID="script_chinh" runat="server" EnableCdn="false">
            <Scripts><asp:ScriptReference Name="jquery" /></Scripts>
        </asp:ScriptManager>
        <header class="site-header">
            <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>">PetDream<span>Thế giới thú cưng đáng yêu</span></a>
            <nav class="account-nav" aria-label="Điều hướng chính">
                <a href="<%= ResolveUrl("~/Default.aspx") %>">Trang chủ</a>
                <a href="<%= ResolveUrl("~/ThuCung.aspx") %>">Thú cưng <span aria-hidden="true">↗</span></a>
                <a href="<%= ResolveUrl("~/LienHe.aspx") %>">Liên hệ</a>
                <% if (Request.IsSecureConnection) { %>
                    <a href="<%= ResolveUrl("~/GioHang.aspx") %>">Giỏ hàng</a>
                <% } %>
                <% if (XacThucTaiKhoan.HienTai(Context) == null) { %>
                    <a href="<%= ResolveUrl("~/DangNhap.aspx") %>">Đăng nhập</a>
                <% } else { %>
                    <a href="<%= ResolveUrl("~/TaiKhoan.aspx") %>">Tài khoản</a>
                    <% if (XacThucTaiKhoan.LaQuanTri(XacThucTaiKhoan.HienTai(Context))) { %>
                        <a href="<%= ResolveUrl("~/Admin/Default.aspx") %>">Quản trị</a>
                    <% } %>
                <% } %>
            </nav>
        </header>
        <main id="noi-dung" class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
        <footer class="site-footer"><strong>PetDream</strong><p>Ngôi nhà của những người yêu thú cưng</p><small>Website đồ án · Hồ sơ và ảnh AI chỉ dùng minh họa</small></footer>
    </form>
</body>
</html>

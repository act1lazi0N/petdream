<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
    <clear />
    <!-- Mẫu không chứa mật khẩu. Chỉnh bản ConnectionStrings.config trên máy chạy. -->
    <add name="PetDream"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PetDream;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Application Name=PetDream"
         providerName="System.Data.SqlClient" />
</connectionStrings>

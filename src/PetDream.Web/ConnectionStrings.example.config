<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
    <clear />
    <!-- Chỉ dùng LocalDB trên máy phát triển: instance này không hỗ trợ TLS.
         SQL Server từ xa phải dùng cấu hình riêng với Encrypt=True và chứng chỉ hợp lệ. -->
    <add name="PetDream"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PetDream;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=False;Application Name=PetDream"
         providerName="System.Data.SqlClient" />
</connectionStrings>

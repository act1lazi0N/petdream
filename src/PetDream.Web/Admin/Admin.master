<%@ Master Language="C#" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PetDream | Quản trị</title>
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form id="form_quantri" runat="server">
        <header class="site-header">
            <a class="brand" href="<%= ResolveUrl("~/Admin/Default.aspx") %>">PetDream<span>Khung quản trị</span></a>
            <a href="<%= ResolveUrl("~/Default.aspx") %>">Về trang chủ</a>
        </header>
        <main class="container admin-content">
            <asp:ContentPlaceHolder ID="AdminContent" runat="server" />
        </main>
    </form>
</body>
</html>

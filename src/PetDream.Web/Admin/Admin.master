<%@ Master Language="C#" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PetDream | Quản trị</title>
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
    <link href="~/Content/admin-catalog.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form id="form_quantri" runat="server">
        <asp:ScriptManager ID="script_quantri" runat="server" EnableCdn="false">
            <Scripts><asp:ScriptReference Name="jquery" /></Scripts>
        </asp:ScriptManager>
        <header class="site-header">
            <a class="brand" href="<%= ResolveUrl("~/Admin/Default.aspx") %>">PetDream<span>Khung quản trị</span></a>
            <nav class="account-nav" aria-label="Điều hướng tài khoản">
                <a href="<%= ResolveUrl("~/Admin/Loai.aspx") %>">Loài</a>
                <a href="<%= ResolveUrl("~/Admin/ThuCung.aspx") %>">Thú cưng</a>
                <a href="<%= ResolveUrl("~/Default.aspx") %>">Trang chủ</a>
                <a href="<%= ResolveUrl("~/DangXuat.aspx") %>">Đăng xuất</a>
            </nav>
        </header>
        <main class="container admin-content">
            <asp:ContentPlaceHolder ID="AdminContent" runat="server" />
        </main>
    </form>
</body>
</html>
